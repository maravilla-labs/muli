# MongoDB
MULI_MONGODB_URL=mongodb://localhost:27017
MULI_MONGODB_DATABASE=muli

# gRPC Server
MULI_GRPC_PORT=50051
MULI_METRICS_PORT=9090

# Authentication (optional - when set, all gRPC requests require Bearer token)
# MULI_API_KEY=

# TLS (optional - when both cert and key are set, gRPC server uses TLS)
# MULI_TLS_CERT_PATH=
# MULI_TLS_KEY_PATH=
# MULI_TLS_CA_CERT_PATH=

# Docker
MULI_MAX_CONCURRENT_JOBS=10
MULI_MAX_JOBS_PER_TENANT=3
MULI_CONTAINER_TIMEOUT_SECONDS=3600
MULI_CLEANUP_INTERVAL_SECONDS=300
MULI_CLEANUP_MAX_AGE_SECONDS=3600

# Resource Limits (total available for jobs)
MULI_TOTAL_CPU_MILLICORES=8000
MULI_TOTAL_MEMORY_BYTES=17179869184

# Config file (optional — path to a TOML config file to load before env vars)
# MULI_CONFIG=/etc/muli/config.toml

# Data directory — single root for all persistent data.
# SQLite databases are stored directly here; registry and git paths are derived
# as {data_dir}/registry and {data_dir}/git unless overridden below.
MULI_DATA_DIR=./data

# Registry (multi-tenant, subdomain-based: {tenant}.MULI_REGISTRY_DOMAIN)
MULI_REGISTRY_ENABLED=true
MULI_REGISTRY_PORT=5000
MULI_REGISTRY_DOMAIN=localhost
# Optional override — defaults to {MULI_DATA_DIR}/registry
# MULI_REGISTRY_ROOT=/var/lib/muli/registry
MULI_REGISTRY_MAX_SIZE_GB=50
MULI_REGISTRY_MAX_BLOB_SIZE_MB=5120
# MULI_REGISTRY_TLS_CERT_PATH=
# MULI_REGISTRY_TLS_KEY_PATH=

# Git Hosting (Multi-tenant)
MULI_GIT_ENABLED=false
MULI_GIT_PORT=7000
MULI_GIT_DOMAIN=localhost
# Allow localhost/private-IP webhook URLs (dev only — never enable in production)
# MULI_GIT_ALLOW_LOCALHOST_WEBHOOKS=true
# Optional override — defaults to {MULI_DATA_DIR}/git
# MULI_GIT_ROOT=/var/lib/muli/git

# Default Docker Registry Credentials
MULI_DEFAULT_REGISTRY_SERVER=registry.digitalocean.com
MULI_DEFAULT_REGISTRY_USERNAME=
MULI_DEFAULT_REGISTRY_PASSWORD=

# Logging
RUST_LOG=info,muli=debug
